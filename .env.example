# Copy this file to ".env" and fill in your values. The API and drizzle-kit
# both read it automatically — no need to `set` variables in your terminal.

# REQUIRED — Postgres connection string.
# Docker (see docker-compose.yml):  postgresql://postgres:shipfast@localhost:5432/shipfast
# Neon / Supabase: paste the connection string they give you (often needs ?sslmode=require)
DATABASE_URL=postgresql://postgres:shipfast@localhost:5432/shipfast

# OPTIONAL — web dev server (defaults shown)
PORT=5000
BASE_PATH=/

# OPTIONAL — email notifications (Resend). If unset, emails are logged to the console.
# RESEND_API_KEY=
# NOTIFY_EMAIL_FROM=ShipFast <notifications@yourdomain.com>

# OPTIONAL — SMS notifications (Twilio). If unset, texts are logged to the console.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# OPTIONAL — used to build tracking links inside notifications
# PUBLIC_BASE_URL=http://localhost:5173

# OPTIONAL — pricing
# FUEL_SURCHARGE_PCT=16
